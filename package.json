{
  "name": "uniway",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "predev": "node scripts/prepare-ocr.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:ocr": "node scripts/test-ocr.mjs",
    "prebuild": "node scripts/prepare-ocr.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src tests scripts docs .github *.md *.json *.ts",
    "format:check": "prettier --check src tests scripts docs .github *.md *.json *.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "7.0.0",
    "@tesseract.js-data/eng": "1.0.0"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "typescript": "^5.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.6.2"
  },
  "license": "MIT",
  "description": "Turn campus layouts into private, interactive wayfinding maps.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MI1000-67/uniway.git"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
